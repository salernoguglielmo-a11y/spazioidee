# ─────────────────────────────────────────────────────────────
# Spazio Idee — configurazione
# Copia questo file in .env.local e compila i valori.
# ─────────────────────────────────────────────────────────────

# Identità dell'applicazione
APP_NAME="Spazio Idee"
# URL pubblico: i link di accesso vengono costruiti da qui. In produzione usa https://
APP_URL="http://localhost:3000"

# Chiave per firmare le sessioni. Generala con:  openssl rand -base64 48
AUTH_SECRET=""
# Durata della sessione in giorni
SESSION_DAYS="30"

# ── ACCESSI ───────────────────────────────────────────────────
# Chi può entrare. Nessun altro indirizzo viene accettato.
# Gli amministratori possono aggiungere altri indirizzi dall'interfaccia (/admin).
ADMIN_EMAILS="tua.email@dominio.it"
ALLOWED_EMAILS="collaboratore@dominio.it,commercialista@dominio.it"
# "shared": tutti gli autorizzati vedono tutti i progetti. "private": ognuno vede i propri.
PROJECT_VISIBILITY="shared"

# ── CLAUDE ────────────────────────────────────────────────────
# Chiave API da console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Profondità di ragionamento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT="high"
# Ricerca web automatica nei moduli che la prevedono (mercato, concorrenza, normativa)
ENABLE_WEB_SEARCH="true"
WEB_SEARCH_MAX_USES="8"

# ── EMAIL (link di accesso) ───────────────────────────────────
MAIL_FROM="Spazio Idee <no-reply@tuodominio.it>"
# Opzione A: Resend (https://resend.com)
RESEND_API_KEY=""
# Opzione B: SMTP  es. smtps://utente:password@smtp.dominio.it:465
SMTP_URL=""
# Se non configuri nessuno dei due, il link di accesso viene mostrato a video
# e stampato nei log: va bene in locale, non in produzione.

# ── DATI ──────────────────────────────────────────────────────
# SQLite locale (default) oppure un URL libsql/Turso per il deploy
DATABASE_URL="file:./data/spazioidee.db"
DATABASE_AUTH_TOKEN=""
DATA_DIR="./data"

# ── DOCUMENTI E CONTESTO ──────────────────────────────────────
MAX_UPLOAD_MB="25"
# Caratteri di documenti inviati al modello prima di ridurre il testo
CONTEXT_CHAR_BUDGET="500000"
# Invia a Claude i PDF privi di testo selezionabile (deck grafici, scansioni)
NATIVE_PDF="true"
NATIVE_PDF_MAX_MB="8"
NATIVE_PDF_MAX_DOCS="4"
